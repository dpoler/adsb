[Unit]
Description=FlightLevel314 ADS-B display (Raspberry Pi kiosk)
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/opt/flightlevel314/flightlevel314
Restart=always
RestartSec=2
User=flightlevel314
# storage_linux.cpp/locations_linux.cpp resolve config to
# $HOME/.config/flightlevel314/ -- the service user has no real home
# directory (useradd -r, no -m), so HOME is pinned here to a directory
# under the app's own install path instead of relying on passwd's HOME
# field. See README.md's kiosk-install section for how this gets
# seeded/chowned.
Environment=HOME=/opt/flightlevel314
# DRM (/dev/dri/*) and touch input (/dev/input/*) access -- see
# README.md for the udev/group setup this expects.
SupplementaryGroups=video input render

[Install]
WantedBy=multi-user.target
